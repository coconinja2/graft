{
  "name": "graft",
  "version": "1.0.0",
  "description": "Shared resource coordination layer for parallel AI coding agents",
  "main": "dist/sdk/client.js",
  "bin": {
    "graft": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/dashboard && cp src/dashboard/index.html dist/dashboard/index.html",
    "start": "node dist/cli/index.js",
    "test": "jest",
    "dev": "ts-node src/cli/index.ts",
    "simulate": "node scripts/simulate.mjs",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "exports": {
    ".": "./dist/sdk/client.js",
    "./openai": "./dist/adapters/openai/tools.js",
    "./mcp": "./dist/adapters/mcp/server.js"
  },
  "keywords": [
    "ai",
    "agents",
    "coordination",
    "parallel"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^12.0.0",
    "fastify": "^4.26.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^22.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "roots": [
      "<rootDir>/tests"
    ]
  }
}
